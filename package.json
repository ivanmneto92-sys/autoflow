{
  "name": "autoflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automação de Instagram por fluxos (estilo ManyChat) — MVP1 sem IA",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:web": "npm --prefix web run dev",
    "setup:web": "npm --prefix web install",
    "dev": "concurrently -k -n api,worker,tunel,web -c blue,green,magenta,yellow \"npm:dev:api\" \"npm:dev:worker\" \"cloudflared tunnel run --url http://127.0.0.1:3000 autoflow\" \"npm:dev:web\"",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/worker/index.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "tsx test/integration.ts",
    "dev:ngrok": "concurrently -k -n api,worker,ngrok,web -c blue,green,magenta,yellow \"npm:dev:api\" \"npm:dev:worker\" \"ngrok http 127.0.0.1:3000 --log=stdout --log-format=term\" \"npm:dev:web\"",
    "sync:schema": "node -e \"const f=require('fs');f.writeFileSync('web/src/shared/schema.ts','// CÓPIA de ../../../src/flow/schema.ts — atualize com: npm run sync:schema (na raiz)\\n'+f.readFileSync('src/flow/schema.ts','utf8'))\"",
    "deploy:web": "npm --prefix web run deploy"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/formbody": "^8.0.2",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "concurrently": "^9.2.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
