{
  "name": "Só para seguidores",
  "description": "Quem comentar recebe o conteúdo só se seguir a conta; quem não segue recebe o passo a passo para seguir e tentar de novo.",
  "category": "geral",
  "icon": "🔒",
  "tags": [
    "seguidores",
    "comentário"
  ],
  "flow": {
    "start": "pede_clique",
    "nodes": {
      "pede_clique": {
        "type": "message",
        "data": {
          "text": "Oi, {{first_name|tudo bem}}! 👋 Esse conteúdo é exclusivo para quem me segue. Toca no botão abaixo que eu confiro rapidinho 👇",
          "buttons": [
            {
              "label": "Quero receber",
              "next": "checa_seguidor"
            }
          ]
        }
      },
      "checa_seguidor": {
        "type": "condition",
        "data": {
          "rules": [
            {
              "when": {
                "type": "is_follower"
              },
              "next": "entrega"
            }
          ],
          "else": "nao_segue"
        }
      },
      "entrega": {
        "type": "message",
        "data": {
          "text": "Prontinho! 🎉 Obrigado por me seguir. Aqui está o seu acesso:",
          "buttons": [
            {
              "label": "Acessar agora",
              "url": "https://seusite.com.br"
            }
          ]
        }
      },
      "nao_segue": {
        "type": "message",
        "data": {
          "text": "Ainda não encontrei você entre os meus seguidores 😕\n\n1️⃣ Abra o meu perfil e toque em Seguir\n2️⃣ Volte aqui e toque no botão abaixo",
          "buttons": [
            {
              "label": "Pronto, já sigo",
              "next": "checa_seguidor"
            }
          ]
        }
      }
    }
  },
  "triggers": [
    {
      "type": "comment",
      "priority": 10,
      "config": {
        "media_id": null,
        "keywords": [
          "quero"
        ],
        "match": "contains",
        "public_replies": [
          "Te chamei no direct! 📩",
          "Corre no direct 😉"
        ],
        "once_per_contact": false
      }
    }
  ]
}
