# ── Servidor ──
NODE_ENV=development
PORT=3000
# URL pública da API (no dev use ngrok/cloudflared: a Meta precisa alcançar os webhooks em HTTPS)
PUBLIC_BASE_URL=https://SEU-TUNEL.ngrok-free.app
# Opcional no dev: iniciar o login pela API local e receber só o callback pelo túnel
# IG_CONNECT_START_BASE_URL=http://127.0.0.1:3000
# (opcional) para onde o usuário volta depois de conectar o Instagram
# DASHBOARD_URL=https://app.autoflow.com.br/conectado

# ── Banco e fila ──
# Local (docker compose): postgres://autoflow:autoflow@localhost:5432/autoflow
# Supabase: Project Settings → Database → Connection string (use a porta 5432 / session pooler)
DATABASE_URL=postgres://autoflow:autoflow@localhost:5432/autoflow
REDIS_URL=redis://localhost:6379

# ── App da Meta (Instagram API com login do Instagram) ──
# developers.facebook.com → seu app → Instagram → API setup with Instagram login
IG_APP_ID=
IG_APP_SECRET=
# Qualquer string; a mesma vai no campo "Verify token" do webhook no painel da Meta
IG_WEBHOOK_VERIFY_TOKEN=troque-por-um-texto-aleatorio
IG_GRAPH_VERSION=v21.0
# instagram = API com login do Instagram | facebook = login unificado (Login do Facebook para Empresas)
IG_LOGIN_MODE=instagram
# Config ID do login unificado (só no modo facebook)
IG_LOGIN_CONFIG_ID=

# ── Painel (login via Supabase Auth) ──
# Supabase → Project Settings → API: URL e chave publicável (sb_publishable_...)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ── Segurança ──
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
STATE_SECRET=
ADMIN_API_KEY=

# Publicações agendadas: pasta onde ficam as mídias (servidas em PUBLIC_BASE_URL/media) e limite de upload
MEDIA_DIR=uploads
MEDIA_MAX_MB=240
PUBLISH_POLL_SECONDS=20
WORKER_CONCURRENCY=10
LOG_LEVEL=info
